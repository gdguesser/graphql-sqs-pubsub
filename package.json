{
  "name": "@gdguesser/graphql-sqs-pubsub",
  "version": "0.1.0",
  "description": "Direct SQS transport for GraphQL subscriptions with process-local fan-out",
  "keywords": [
    "apollo",
    "aws",
    "graphql",
    "graphql-subscriptions",
    "pubsub",
    "sqs"
  ],
  "homepage": "https://github.com/gdguesser/graphql-sqs-pubsub#readme",
  "bugs": {
    "url": "https://github.com/gdguesser/graphql-sqs-pubsub/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gdguesser/graphql-sqs-pubsub.git"
  },
  "license": "MIT",
  "author": "Gabriel Dietrich Guesser",
  "contributors": [
    "John Flockton"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.examples.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude tests/integration/localstack.test.ts",
    "test:coverage": "vitest run --coverage --exclude tests/integration/localstack.test.ts",
    "test:integration": "RUN_LOCALSTACK_INTEGRATION=1 vitest run tests/integration/localstack.test.ts",
    "test:example": "vitest run tests/example",
    "example": "tsx examples/apollo-server.ts",
    "localstack:up": "docker compose up -d --wait",
    "localstack:down": "docker compose down",
    "exports:check": "node scripts/check-exports.mjs",
    "pack:check": "node scripts/validate-pack.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run exports:check && npm run pack:check && npm run audit:prod",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1104.0"
  },
  "peerDependencies": {
    "graphql": "^16.0.0",
    "graphql-subscriptions": "^3.0.0"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "devDependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@eslint/js": "^10.0.1",
    "@graphql-tools/schema": "^10.0.38",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "express": "^5.2.1",
    "graphql": "^16.14.2",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.2.1",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.9",
    "typescript": "<7.1.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10",
    "ws": "^8.21.2"
  }
}
